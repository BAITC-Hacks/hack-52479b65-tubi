  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "question_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Question Id"
          },
          "fields": {
            "items": {
              "type": "string",
              "enum": [
                "title",
                "context",
                "need",
                "users",
                "data",
                "expected_result",
                "success_criteria",
                "constraints",
                "contact",
                "interaction_format"
              ]
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Fields"
          },
          "question": {
            "type": "string",
            "maxLength": 6000,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 6000,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "fields",
          "question",
          "answer"
        ],
        "title": "Answer"
      },
      "Card": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "category": {
            "type": "string",
            "enum": [
              "analytics",
              "automation",
              "education",
              "marketing",
              "other"
            ],
            "title": "Category",
            "default": "analytics"
          },
          "context": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Context"
          },
          "need": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Need"
          },
          "users": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Users"
          },
          "data": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "expected_result": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Result"
          },
          "success_criteria": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Success Criteria"
          },
          "constraints": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Constraints"
          },
          "contact": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact"
          },
          "interaction_format": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000
              },
              {
                "type": "null"
              }
            ],
            "title": "Interaction Format"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Card"
      },
      "DecisionInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DecisionInput"
      },
      "EvaluateInput": {
        "properties": {
          "card": {
            "$ref": "#/components/schemas/Card"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "card"
        ],
        "title": "EvaluateInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PrepareInput": {
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "clarify",
              "compose"
            ],
            "title": "Stage"
          },
          "description": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 5,
            "title": "Description"
          },
          "category": {
            "type": "string",
            "enum": [
              "analytics",
              "automation",
              "education",
              "marketing",
              "other"
            ],
            "title": "Category"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/Answer"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stage",
          "description",
          "category"
        ],
        "title": "PrepareInput"
      },
      "ProposalInput": {
        "properties": {
          "team_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Team Id"
          },
          "idea": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Idea"
          },
          "plan": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Plan"
          },
          "deadline": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Deadline"
          },
          "prototype_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Prototype Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "team_id",
          "idea",
          "plan",
          "deadline"
        ],
        "title": "ProposalInput"
      },
      "SaveInput": {
        "properties": {
          "card": {
            "$ref": "#/components/schemas/Card"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "card",
          "confirmed"
        ],
        "title": "SaveInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
