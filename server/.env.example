# Copy to server/.env. Keep secrets out of Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Empty key = clearly marked fallback with deterministic questions.
# Restart the backend after editing server/.env. Process environment takes priority.
# Relative database paths are resolved from the repository root, not the terminal folder.
# TUBI_DB_PATH=/absolute/path/to/tubi.sqlite3
